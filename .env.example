QUANTCORE_DATA_DIR=datasets
QUANTCORE_MODE=demo
# Direct uvicorn: choose demo or alpaca. make real-dashboard selects alpaca for Compose.
QUANTCORE_DATA_SOURCE=demo
QUANTCORE_MARKET_DATA_DIR=datasets
# Required only when exposing the API outside localhost; never put this in NEXT_PUBLIC variables.
QUANTCORE_API_TOKEN=
QUANTCORE_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# Optional: historical market data; explicit paper CLI can also use paper credentials.
# Trading host is hardcoded to https://paper-api.alpaca.markets. Never commit actual values.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Optional dedicated paper credentials take precedence over the pair above.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
# Read-only paper performance projection for the analysis API (no broker keys).
# QUANTCORE_PAPER_PERFORMANCE_DIR=artifacts/paper_performance_public
# Official SEC metadata; actual contact configured locally, never committed.
# SEC_USER_AGENT="QuantCore Research real-contact@example.com"
# QUANTCORE_CORPORATE_DIR=artifacts/corporate_public

# Opt-in language-model analysis. Leave disabled until provider/model are configured.
QUANTCORE_LLM_ENABLED=false
QUANTCORE_LLM_PROVIDER=anthropic
QUANTCORE_LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# Alternative provider credentials are kept separate.
OPENAI_API_KEY=
# Explicitly enable only when remote source processing and API costs are authorized.
QUANTCORE_LLM_REMOTE_ALLOWED=false
# Alternative: QUANTCORE_LLM_PROVIDER=ollama, using an already installed local model.
OLLAMA_HOST=http://127.0.0.1:11434

# Optional local research roles. A mapping of SHA-256 key hashes to viewer or researcher.
QUANTCORE_API_USERS_JSON=
QUANTCORE_WEB_SIGN_IN=false
QUANTCORE_MONITOR_TOKEN=
